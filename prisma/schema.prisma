// 团队任务报单系统 数据模型（Prisma + PostgreSQL）
// 动态任务表单引擎 V2：
//  - 表单模板 TaskTemplate（schemaJson 存字段定义，支持 文本/数字/图片/下拉/日期/勾选）
//  - 任务实例 TaskInstance（按模板发布，带总槽位数 quota）
//  - 提交 Submission（一人可抢多个槽、提交多条；不再限制一人一实例一条）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING  // 待人工审核
  ACTIVE   // 已通过
  DISABLED // 已禁用
}

enum SubmissionStatus {
  GRABBED   // 已抢单未提交
  SUBMITTED // 已提交待审核
  APPROVED  // 通过
  REJECTED  // 驳回
}

enum TaskStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique // 星际未来邮箱，唯一
  phone        String     @unique // 商城手机号，唯一（一对一绑定）
  name         String?    // 会员姓名（资料字段，可空）
  level        String     @default("普通会员") // 会员等级
  passwordHash String
  status       UserStatus @default(PENDING)
  inviteCode   String?   // 注册所用邀请码
  referrerId   Int?
  referrer     User?      @relation("Referral", fields: [referrerId], references: [id])
  referrals    User[]     @relation("Referral")
  path         String     @default("") // 物化路径，如 /1/5/9/
  depth        Int        @default(0)
  reviewedById Int?
  reviewedAt   DateTime?
  createdAt    DateTime   @default(now())

  submissions  Submission[]
  createdCodes InviteCode[] @relation("Owner")
}

model InviteCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  ownerId   Int
  owner     User     @relation("Owner", fields: [ownerId], references: [id])
  usedById  Int?
  status    String   @default("UNUSED") // UNUSED / USED
  createdAt DateTime @default(now())
}

model TaskTemplate {
  id          Int           @id @default(autoincrement())
  name        String
  schemaJson  String        // 动态表单字段定义（JSON 文本）
  status      TaskStatus    @default(DRAFT)
  createdById Int
  createdAt   DateTime      @default(now())
  instances   TaskInstance[]
}

model TaskInstance {
  id         Int           @id @default(autoincrement())
  templateId Int
  template   TaskTemplate  @relation(fields: [templateId], references: [id])
  title      String
  date       DateTime      @db.Date
  quota      Int           // 总槽位数
  grabbed    Int           @default(0) // 已抢数
  startTime  DateTime
  endTime    DateTime
  status     String        @default("OPEN") // OPEN / CLOSED
  createdAt  DateTime      @default(now())
  submissions Submission[]
}

model Submission {
  id             Int              @id @default(autoincrement())
  instanceId     Int
  instance       TaskInstance     @relation(fields: [instanceId], references: [id])
  userId         Int
  user           User             @relation(fields: [userId], references: [id])
  data           String           // 字段值 JSON
  images         String?          // 图片 URL 数组 JSON
  status         SubmissionStatus @default(GRABBED)
  submitDeadline DateTime?        // 截止时间（取任务 endTime）
  submittedAt    DateTime?
  reviewedById   Int?
  reviewedAt     DateTime?
  rejectReason   String?
  createdAt      DateTime         @default(now())
}

model RelationAdjustLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  oldReferrer Int?
  newReferrer Int?
  oldPath    String?
  newPath    String?
  operatorId Int
  reason     String?
  createdAt  DateTime @default(now())
}

model ExportRecord {
  id         Int      @id @default(autoincrement())
  instanceId Int
  date       DateTime @db.Date
  filePath   String
  rowCount   Int
  createdById Int
  createdAt  DateTime @default(now())
}
