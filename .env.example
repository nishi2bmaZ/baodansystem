# 复制为 .env 后填写。请勿把本文件提交到公开仓库。

# 数据库连接（容器内用 db:5432；本地调试用 127.0.0.1:5433）
DATABASE_URL=postgresql://baodan:baodan@db:5432/baodan

# Redis
REDIS_URL=redis://redis:6379

# 应用
APP_PORT=3000
JWT_SECRET=请改成随机长字符串

# 对象存储（图片，可选，先用本地/COS）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# 邮件通知（驳回/审核结果，可选）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
