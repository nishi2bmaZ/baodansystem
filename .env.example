# 复制为 .env 后填写。请勿把本文件提交到公开仓库。

# 数据库连接（容器内用 db:5432；本地调试用 127.0.0.1:5433）
DATABASE_URL=postgresql://baodan:baodan@db:5432/baodan

# Redis
REDIS_URL=redis://redis:6379

# 应用
APP_PORT=3000
JWT_SECRET=请改成随机长字符串
# 对外访问基线网址（用于导出 CSV 的图片生成可打开的绝对网址）。
# 留空则自动取当前导出请求的真实域名/端口；若套了 HTTPS 域名或 CDN，请填完整地址，如 https://baodan.example.com
PUBLIC_BASE=

# 对象存储（图片，可选，先用本地/COS）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# 邮件通知（驳回/审核结果，可选）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
